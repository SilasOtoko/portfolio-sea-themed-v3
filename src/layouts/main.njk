<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {# ── SEO defaults — override any of these via page front matter ── #}
    {% set siteTitle   = "Josiah Schaefer | Front-End Developer" %}
    {% set siteDesc    = "Portfolio site for Josiah Schaefer, Front-End Developer." %}
    {% set siteUrl     = "https://josiahschaefer.com" %}
    {% set pageUrl     = siteUrl + page.url %}
    {% set pageImage   = ogImage or (siteUrl + "/img/hgc.png") %}
    {% set resolvedTitle = (pageTitle + " | " + siteTitle) if pageTitle else siteTitle %}
    {% set resolvedDesc  = description or siteDesc %}

    <title>{{ resolvedTitle }}</title>
    <meta name="description" content="{{ resolvedDesc }}" />
    <link rel="canonical" href="{{ pageUrl }}" />

    {# ── Open Graph ── #}
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content="{{ pageUrl }}" />
    <meta property="og:title"       content="{{ resolvedTitle }}" />
    <meta property="og:description" content="{{ resolvedDesc }}" />
    <meta property="og:image"       content="{{ pageImage }}" />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name"   content="{{ siteTitle }}" />

    {# ── Twitter / X ── #}
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content="{{ resolvedTitle }}" />
    <meta name="twitter:description" content="{{ resolvedDesc }}" />
    <meta name="twitter:image"       content="{{ pageImage }}" />

    {# ── JSON-LD structured data ── #}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Josiah Schaefer",
      "url": "{{ siteUrl }}",
      "jobTitle": "Front-End Developer",
      "description": "{{ siteDesc }}",
      "image": "{{ siteUrl }}/img/josiah-schaefer.jpg",
      "sameAs": [
        "https://linkedin.com/in/josiahschaefer"
      ]
    }
    </script>

    {# ── Favicons + PWA ── #}
    <link rel="icon" type="image/svg+xml" href="/img/octopus-favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#042C53" />

    {# ── Critical CSS ── #}
    <style>
      .sidenav {
        transform: translate3d(100%, 0, 0);
      }
      .sidenav-open {
        transform: translateX(0);
      }
    </style>

    {# ── Fonts ── #}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=Quicksand:wght@300..700&display=swap" rel="stylesheet" />
  </head>

  <body
    class="overflow-x-hidden"
    x-bind:class="{ 'h-full overflow-hidden': navOpen }"
    x-data="{
      navOpen: false,
      triggered: false,
    }"
  >

    {% include "../template-parts/header.njk" %}

    <main class="flex flex-col min-h-screen">
      {% block content %}{% endblock %}
    </main>

    <script type="module" src="/src/js/main.js"></script>
  </body>
</html>
